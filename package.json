{
  "name": "spy-pro",
  "version": "1.0.0",
  "description": "Spy Pro — Control every fullscreen request: block, in-window, popup window, sticky, or native.",
  "author": "Thanmai (posathanmai1-lang)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/posathanmai1-lang/spy-pro.git"
  },
  "bugs": {
    "url": "https://github.com/posathanmai1-lang/spy-pro/issues"
  },
  "homepage": "https://github.com/posathanmai1-lang/spy-pro#readme",
  "keywords": [
    "spy-pro",
    "fullscreen-control",
    "chrome-extension",
    "windowed",
    "in-window",
    "sticky-fullscreen",
    "pip",
    "pointer-lock"
  ],
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "preview": "vite build && echo \"Load dist/ folder as unpacked extension in Chrome\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.29",
    "@types/chrome": "^0.0.268",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^1.4.0",
    "webextension-polyfill": "^0.10.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
